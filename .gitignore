# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# VS Code
.vscode/

# Data, logs, and outputs
outputs/
**/outputs/
**/logs/
*.log
*.tmp
*.bak

# Checkpoints and large model files
*.pt
*.onnx
*.ckpt
*.bin
*.gguf

# OS files
.DS_Store
Thumbs.db

# Jupyter and IPython
.ipynb_checkpoints/

# Python packaging
*.egg-info/
.eggs/
build/
dist/

# Local tools & cache
**/__pycache__/
*.swp
*.swo

# Video and raw sensor data
*.mp4
*.bag

# Application-specific
smart_walker/models/
smart_walker/tools/

# Thesis and journal writing.
# Everything for both lives under thesis/: the thesis chapters in DTR Thesis/,
# the journal drafts in Journal Prep/, the source PDFs in Reference/, and the
# working notes in Claude Session/ and ChatGPT Session/. This is manuscript
# material rather than code, it is large and binary, and it should not be
# versioned with the implementation.
thesis/

# Scratch/working directory at the repo root, used when unzipping .docx
# files for image extraction, pulling figures out of PDFs for verification,
# and similar throwaway analysis. Regenerated on demand and never a source
# of truth, so it should not be versioned.
/tmp/

# Local agent/skill configuration at the repo root, tool-specific and
# personal to whoever is running the assistant, not part of the project.
/.agents/

# Codex CLI's working artifacts at the repo root, tool-specific and
# regenerated on demand, not part of the project.
/.codex_artifacts/

# Microsoft Office lock and recovery files, which Word leaves behind while a
# document is open.
~$*
*.asd
*.wbk

# LibreOffice lock files
.~lock.*#

# Recorded camera data. `logs/` holds evaluation runs, written whenever the
# client is started with --evaluate, and `captures/` holds the standalone
# scene captures from scripts/capture_scenes.py. Both are 8-bit colour PNGs
# and 16-bit depth PNGs, hundreds of megabytes per run, and both are
# research data rather than code.
#
# Being ignored here means git will not preserve them. They cannot be
# regenerated without walking the same route again, and the recordings of
# 22 August 2026 are the only ones of that staircase, so they need backing
# up somewhere outside the repository.
smart_walker/logs/
smart_walker/captures/

# Scratch note at the repo root listing which modules load during a run.
# Working material, regenerated by reading the imports, not part of the
# project.
/audit.txt
