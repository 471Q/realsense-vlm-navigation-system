{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hdsg:schema:release:v1",
  "title": "HDSG Authoritative Release Object v2",
  "description": "The only record from which user-visible caption text may be consumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "authority",
    "content",
    "evidence",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "hdsg.release.v2"
    },
    "identity": {
      "$ref": "#/definitions/identity"
    },
    "authority": {
      "$ref": "#/definitions/authority"
    },
    "content": {
      "$ref": "#/definitions/content"
    },
    "evidence": {
      "$ref": "#/definitions/evidence"
    },
    "verification": {
      "$ref": "#/definitions/verification"
    }
  },
  "definitions": {
    "fact_id": {
      "type": "string",
      "pattern": "^(sector:(left|centre|right)|object:[A-Za-z0-9._-]+|condition:[a-z][a-z0-9._-]*)$"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^m:[a-z][a-z0-9._-]*(?::[a-z0-9._-]+)+$"
    },
    "reason_code": {
      "description": "Every code the runtime can emit, and no others. Six went with the templated contract on 21 August 2026 and were removed from this list on 24 August 2026, their only remaining purpose having been to validate archives that were deleted the day before: RG_CLAUSE_FORMAT_INVALID, RG_REQUIRED_FACT_MISSING, RG_PLACEHOLDER_INVALID, RG_MOVEMENT_FACT_REQUIRED, RG_STATE_EXPRESSION_MISMATCH and RG_NEGATION_DETECTED. Each screened a controlled sentence chosen from the runtime's own list. RG_SUBJECT_MISMATCH was retired with them and revived on 22 August 2026 for the composed contract, where it means a clause states a number without naming the fact the number was declared against. RG_REQUIRED_FACT_MISSING was revived on 25 August 2026 in the same way, and means the caption does not state the measurement the decision rests on. It had been described here as having no composed equivalent by design, on the ground that establishing prose coverage of a required fact would need the linguistic inference the architecture keeps outside the safety boundary. That reasoning was carried over from the templated contract and does not apply to the composed one: the model declares each measurement it states against the fact identifier it belongs to, so the check compares identifiers and reads no prose. Five codes are now unreachable rather than six.",
      "enum": [
        "RG_ACCEPTED",
        "RG_NO_INTENT_EXPRESSED",
        "RG_GENERATION_PENDING",
        "RG_MODEL_UNAVAILABLE",
        "RG_GENERATION_TIMEOUT",
        "RG_CONSTRAINT_FAILURE",
        "RG_STALE_CANDIDATE",
        "RG_IDENTITY_MISMATCH",
        "RG_PARSE_FAILURE",
        "RG_SCHEMA_FAILURE",
        "RG_PROFILE_LIMIT_EXCEEDED",
        "RG_FACT_REFERENCE_INVALID",
        "RG_MEASUREMENT_REFERENCE_INVALID",
        "RG_OBJECT_REFERENCE_INVALID",
        "RG_SUBJECT_MISMATCH",
        "RG_REQUIRED_FACT_MISSING",
        "RG_STATED_VALUE_MISMATCH",
        "RG_NO_MEASUREMENT_STATED",
        "RG_ACTION_LANGUAGE_DETECTED",
        "RG_DIRECT_NUMBER_DETECTED",
        "RG_VISIBLE_TEXT_CONTENT_DETECTED",
        "RG_MODEL_COMMENTARY_DETECTED",
        "RG_UNAPPROVED_LANGUAGE_DETECTED",
        "RG_INTERNAL_GATE_ERROR"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "event_id",
        "observation_id",
        "ticket_id",
        "request_id",
        "released_at_utc"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^release_[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^obs_[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ticket_[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "request_id": {
          "enum": [
            "AUTO_GUIDANCE",
            "MORE_DETAIL",
            "REASSESS"
          ]
        },
        "released_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_advisory",
        "motion_decision",
        "selected_sector",
        "interaction_state",
        "selection_options",
        "action_template_id"
      ],
      "properties": {
        "scene_advisory": {
          "enum": [
            "SAFE",
            "CAUTION",
            "STOP"
          ]
        },
        "motion_decision": {
          "enum": [
            "PROCEED",
            "SLOW",
            "REDIRECT",
            "STOP"
          ]
        },
        "selected_sector": {
          "enum": [
            "LEFT",
            "CENTRE",
            "RIGHT",
            "NONE"
          ]
        },
        "interaction_state": {
          "enum": [
            "GUIDANCE_ACTIVE",
            "AWAITING_SECTOR_CHOICE",
            "REORIENTATION_REQUIRED",
            "POST_REORIENTATION_STABILISING",
            "IDLE_NO_INTENT",
            "GENERATION_PENDING"
          ],
          "description": "IDLE_NO_INTENT and GENERATION_PENDING were introduced by the intent-triggered explanation policy and never reached this enumeration, so every idle and every interim release was non-conformant from 19 August 2026."
        },
        "selection_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "LEFT",
              "CENTRE",
              "RIGHT"
            ]
          }
        },
        "action_template_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "motion_decision": {
                "const": "STOP"
              }
            }
          },
          "then": {
            "properties": {
              "selected_sector": {
                "const": "NONE"
              }
            }
          },
          "else": {
            "properties": {
              "selected_sector": {
                "enum": [
                  "LEFT",
                  "CENTRE",
                  "RIGHT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interaction_state": {
                "enum": [
                  "AWAITING_SECTOR_CHOICE",
                  "REORIENTATION_REQUIRED",
                  "POST_REORIENTATION_STABILISING"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "motion_decision": {
                "const": "STOP"
              },
              "selected_sector": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interaction_state": {
                "const": "AWAITING_SECTOR_CHOICE"
              }
            }
          },
          "then": {
            "properties": {
              "selection_options": {
                "type": "array",
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "selection_options": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_text",
        "reason_text",
        "interaction_text",
        "additional_detail_texts",
        "caption_text"
      ],
      "properties": {
        "action_text": {
          "type": "string",
          "maxLength": 256,
          "description": "Empty in the IDLE_NO_INTENT state, where no intent has been expressed and there is no action to state. The minimum length was removed for that reason rather than to relax the contract on an active release."
        },
        "reason_text": {
          "type": "string",
          "maxLength": 2000,
          "description": "Empty in the IDLE_NO_INTENT and GENERATION_PENDING states, where no reason has been established or released yet. On an accepted release this is the model's caption exactly as written, which is why it can differ from the corresponding stretch of caption_text by a leading capital and a closing full stop: the shown text is sentence-cased on the way to the screen and this field is evidence of what the model produced."
        },
        "interaction_text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "additional_detail_texts": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "caption_text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "measurement_substitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "formatted_value"
      ],
      "properties": {
        "measurement_id": {
          "$ref": "#/definitions/measurement_id"
        },
        "formatted_value": {
          "type": "string",
          "pattern": "^[0-9]+([.][0-9]+)? metres$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_binding_fact_ids",
        "scene_binding_fact_ids",
        "measurement_substitutions",
        "released_visual_observation_ids"
      ],
      "properties": {
        "action_binding_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/fact_id"
          },
          "description": "Empty in the IDLE_NO_INTENT state, where no intent has been expressed and no fact is binding an action. The minimum was removed for that reason rather than to permit an active release with no binding."
        },
        "scene_binding_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/fact_id"
          }
        },
        "measurement_substitutions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/measurement_substitution"
          }
        },
        "released_visual_observation_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^visual:[1-9][0-9]*$"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_mode",
        "candidate_status",
        "gate_outcome",
        "primary_reason_code",
        "reason_codes",
        "guidance_signature",
        "fact_packet_schema",
        "prompt_packet_schema",
        "candidate_schema",
        "code_version"
      ],
      "properties": {
        "release_mode": {
          "enum": [
            "VLM_ACCEPTED",
            "DETERMINISTIC_FALLBACK"
          ]
        },
        "candidate_status": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "UNAVAILABLE"
          ]
        },
        "gate_outcome": {
          "enum": [
            "ACCEPTED",
            "REJECTED_FALLBACK"
          ]
        },
        "primary_reason_code": {
          "$ref": "#/definitions/reason_code"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/reason_code"
          }
        },
        "guidance_signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fact_packet_schema": {
          "const": "hdsg.fact_packet.v2"
        },
        "prompt_packet_schema": {
          "const": "hdsg.prompt_packet.v2"
        },
        "candidate_schema": {
          "description": "The contract the caption was validated against, named so that a release can be read back without knowing which schema set was current. The retired second value was removed on 23 August 2026 with the templated contract it belonged to.",
          "enum": [
            "hdsg.vlm_caption.v1"
          ]
        },
        "code_version": {
          "description": "Which code produced the release. Replaced the literal software_version on 23 August 2026; see the same field in hdsg.fact_packet.v2.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "branch",
            "dirty"
          ],
          "properties": {
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "branch": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "release_mode": {
                "const": "VLM_ACCEPTED"
              }
            }
          },
          "then": {
            "properties": {
              "candidate_status": {
                "const": "ACCEPTED"
              },
              "gate_outcome": {
                "const": "ACCEPTED"
              },
              "primary_reason_code": {
                "const": "RG_ACCEPTED"
              },
              "reason_codes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "const": "RG_ACCEPTED"
                }
              }
            }
          },
          "else": {
            "properties": {
              "candidate_status": {
                "enum": [
                  "REJECTED",
                  "UNAVAILABLE"
                ]
              },
              "gate_outcome": {
                "const": "REJECTED_FALLBACK"
              },
              "primary_reason_code": {
                "not": {
                  "const": "RG_ACCEPTED"
                }
              },
              "reason_codes": {
                "not": {
                  "contains": {
                    "const": "RG_ACCEPTED"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
