{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hdsg:schema:vlm-candidate:v1",
  "title": "HDSG VLM Candidate v1",
  "description": "Constrained reason-only output proposed by the generative model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reason_clauses", "visual_observations"],
  "properties": {
    "schema_version": {
      "const": "hdsg.vlm_candidate.v1"
    },
    "reason_clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/reason_clause"
      }
    },
    "visual_observations": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/visual_observation"
      }
    }
  },
  "definitions": {
    "requirement_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "fact_id": {
      "type": "string",
      "pattern": "^(sector:(left|centre|right)|object:[A-Za-z0-9._-]+|condition:[a-z][a-z0-9._-]*)$"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^m:[a-z][a-z0-9._-]*(?::[a-z0-9._-]+)+$"
    },
    "reason_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "requirement_ids",
        "fact_ids",
        "measurement_ids",
        "text_template"
      ],
      "properties": {
        "clause_id": {
          "type": "string",
          "pattern": "^reason:[1-9][0-9]*$"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/requirement_id"
          }
        },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/fact_id"
          }
        },
        "measurement_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/measurement_id"
          }
        },
        "text_template": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000,
          "pattern": "^[^.!?;\\r\\n]+\\.$"
        }
      }
    },
    "visual_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_observation_id", "proposed_label", "bearing"],
      "properties": {
        "candidate_observation_id": {
          "type": "string",
          "pattern": "^visual:[1-9][0-9]*$"
        },
        "proposed_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9_ ]*$"
        },
        "bearing": {
          "enum": ["LEFT", "CENTRE", "RIGHT"]
        }
      }
    }
  }
}
